<UserControl x:Class="Clenzy.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Clenzy.Presentation.ViewModels;assembly=Clenzy.Presentation">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="34,8,34,28" MaxWidth="1120">
            <TextBlock Text="Recent cleanups" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Reports are stored locally on this PC." Style="{StaticResource SecondaryText}" Margin="0,4,0,16" />
            <Border Style="{StaticResource Card}" Padding="20" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource SecondaryText}" />
            </Border>
            <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding When}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
