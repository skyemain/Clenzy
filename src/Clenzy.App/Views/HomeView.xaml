<UserControl x:Class="Clenzy.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Clenzy.App.Views"
             xmlns:vm="clr-namespace:Clenzy.Presentation.ViewModels;assembly=Clenzy.Presentation">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="34,6,34,34" MaxWidth="1260">
            <TextBlock Text="Your PC, in good shape." Style="{StaticResource PageTitle}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="A clear view of your PC. You decide what gets changed." Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,6,0,20" />

            <Border CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                    Background="{DynamicResource HeroSurfaceBrush}" Padding="26,22" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" MaxWidth="640">
                        <TextBlock Text="PC CARE" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="Ready when you are." FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Scan your PC and clean items allowed by your settings. Clenzy asks before actions that need your review."
                                   Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="{Binding PrimaryButtonText}" Command="{Binding PrimaryCommand}"
                                MinWidth="190" MinHeight="46" Padding="22,12" AutomationProperties.Name="{Binding PrimaryButtonText}"
                                AutomationProperties.HelpText="Scans your PC and cleans only items allowed by your settings." />
                        <TextBlock Text="{Binding OperationText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,0,0,18" Padding="18,16" CornerRadius="15" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ProgressBar IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressFraction, Mode=OneWay}" Height="5"
                                 AutomationProperties.Name="Scan and cleanup progress" />
                    <Grid Margin="0,11,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding OperationText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding LiveStatsText}" Style="{StaticResource SecondaryText}" />
                    </Grid>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Right" Margin="0,9,0,0" Padding="14,6"
                            AutomationProperties.Name="Cancel the current operation" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,18" Padding="17,13" CornerRadius="14" Background="{DynamicResource InfoBackgroundBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Error">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Margin="0,0,0,18" Padding="18,14" CornerRadius="14" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Cleanup result">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="View report" Command="{Binding ViewDetailsCommand}" Margin="0,0,8,0" />
                        <Button Content="Done" Command="{Binding DoneCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="17,15">
                    <StackPanel>
                        <TextBlock Text="DEVICE STORAGE" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding StorageText}" FontSize="16" FontWeight="SemiBold" />
                        <ProgressBar Value="{Binding StorageUsedFraction}" Maximum="1" Height="5" Margin="0,11,0,0"
                                     Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="System drive used space" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0" Padding="17,15">
                    <StackPanel>
                        <TextBlock Text="LAST CLEANUP" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding LastCleanedText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="17,15">
                    <StackPanel>
                        <TextBlock Text="ACCESS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <TextBlock Text="Standard access by default" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Admin rights are requested only when needed." Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <DockPanel LastChildFill="False" Margin="0,0,0,11">
                <TextBlock Text="Explore your PC" FontSize="17" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Right" Text="Choose an area to scan" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryRowViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16,14" MinHeight="104"
                                AutomationProperties.Name="{Binding AutomationName}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource StatusDot}" />
                                <views:Spinner VerticalAlignment="Center" HorizontalAlignment="Left"
                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource StatusText}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="190" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="16,13"
                    Visibility="{Binding ShowRam, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Memory">
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource SectionTitle}" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding RamText}" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Free up memory" Command="{Binding FreeRamCommand}" VerticalAlignment="Center"
                            ToolTip="Asks Windows to release RAM held by idle programs. Nothing is closed; the effect is temporary."
                            AutomationProperties.HelpText="Releases memory held by idle programs without closing anything." />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
