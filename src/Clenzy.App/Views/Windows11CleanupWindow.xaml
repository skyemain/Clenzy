<UserControl x:Class="Clenzy.App.Views.Windows11CleanupWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextBrush}">
    <Grid Margin="30,14,30,24" Background="{DynamicResource WindowBackgroundBrush}" Loaded="PageLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="WINDOWS 11 · PERSONALIZE" Style="{StaticResource SectionTitle}" Margin="0,0,0,5" />
                <TextBlock Text="Debloat" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Available changes for this PC. Select only what you want to change."
                           Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RunAsAdmin" Content="Run as administrator" Click="RunAsAdminClick" Visibility="Collapsed"
                        Margin="0,0,10,0" ToolTip="Clenzy will restart and ask Windows for administrator access." />
                <Button x:Name="Back" Content="←  Home" Click="DoneClick" Padding="15,8" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="13" Padding="15,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Recovery is checked before any changes are made." FontWeight="SemiBold" />
                    <TextBlock Text="Clenzy verifies a new restore point and saves a settings backup. If recovery cannot be verified, it will not apply the selected changes."
                               Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,11" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="Status" Text="Starting the advanced scan…" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="Rescan" Grid.Column="1" Content="↻  Scan again" Click="RescanClick" Visibility="Collapsed" Padding="13,7" />
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <ListBox x:Name="Findings" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Available Windows changes">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="15,13">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}"
                                              VerticalAlignment="Top" Margin="0,3,0,0" AutomationProperties.Name="{Binding Title}" />
                                    <StackPanel Grid.Column="1" Margin="5,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="11"
                                            Padding="8,3" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ChangeKind}" Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border x:Name="EmptyState" Visibility="Collapsed" Style="{StaticResource Card}" Padding="22" VerticalAlignment="Top">
                    <TextBlock Text="No available changes were found for this PC." Style="{StaticResource SecondaryText}" />
                </Border>
                <ScrollViewer x:Name="Report" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Change report" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock x:Name="ReportText" TextWrapping="Wrap" FontSize="13" LineHeight="21" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SelectionCount" Text="0 selected" FontWeight="SemiBold" />
                <TextBlock x:Name="SelectionHint" Text="Nothing changes during the scan." Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelOperation" Content="Cancel scan" Click="CancelClick" Visibility="Collapsed" Margin="0,0,8,0" />
                <Button x:Name="Apply" Style="{StaticResource AccentButton}" Content="Create restore point &amp; apply"
                        Click="ApplyClick" IsEnabled="False" MinWidth="230" Padding="20,11" />
            </StackPanel>
        </Grid>
        <ProgressBar x:Name="Progress" Grid.Row="3" Height="3" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" />
    </Grid>
</UserControl>
