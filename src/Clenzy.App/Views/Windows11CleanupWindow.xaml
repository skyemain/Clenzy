<Window x:Class="Clenzy.App.Views.Windows11CleanupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Clenzy · Debloat" Width="1040" Height="780" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="28" Background="{DynamicResource WindowBackgroundBrush}" Loaded="PageLoaded">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border CornerRadius="16" Padding="22" Margin="0,0,0,16"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#222737" Offset="0"/><GradientStop Color="#504573" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel><TextBlock Text="Windows maintenance" Foreground="#D4CBEF"/><TextBlock Text="Debloat" Foreground="White" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="Review optional apps and Windows preferences." Foreground="#E2DFEE" Margin="0,4,0,0"/></StackPanel></Border>
  <StackPanel Grid.Row="1"><TextBlock x:Name="Status" Text="Scanning your PC…" TextWrapping="Wrap" Margin="0,0,0,12"/><ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,12"/></StackPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Categories" FontWeight="SemiBold" Margin="8"/><ListBox x:Name="Categories" SelectionChanged="FilterChanged" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}"/></StackPanel><ListBox Grid.Column="1" x:Name="Findings" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10"><StackPanel><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding Title}" Click="SelectionClick" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="28,6,0,0" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <ScrollViewer Grid.ColumnSpan="2" Background="{DynamicResource WindowBackgroundBrush}" x:Name="Report" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ReportText" TextWrapping="Wrap" FontSize="14"/></ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,18,0,0"><Button x:Name="Back" Content="Back" Click="DoneClick" DockPanel.Dock="Left" HorizontalAlignment="Left"/><Button x:Name="Rescan" Content="Scan again" Click="ScanClick" DockPanel.Dock="Left" Margin="8,0"/><Button x:Name="Apply" Content="Apply" Click="ApplyClick" DockPanel.Dock="Right" HorizontalAlignment="Right" IsEnabled="False" Padding="28,10"/></DockPanel>
 </Grid>
</Window>
