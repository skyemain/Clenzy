<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Calm midnight surfaces with clear blue and cyan accents. -->
    <Color x:Key="AccentColor">#63D5EE</Color>
    <Color x:Key="HeroGlowColor">#5B82FF</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#080D18" />
    <SolidColorBrush x:Key="GlassTintBrush" Color="#F2080D18" />
    <RadialGradientBrush x:Key="AmbientBrush" Center="0.08,0.08" GradientOrigin="0.08,0.08" RadiusX="0.8" RadiusY="0.9">
        <GradientStop Offset="0" Color="#1822495C" />
        <GradientStop Offset="0.52" Color="#0C192A45" />
        <GradientStop Offset="1" Color="#00080D18" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF141F31" />
        <GradientStop Offset="1" Color="#FF111A2A" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF19263A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF27364D" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF202C40" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#FF2A3B54" />
    <SolidColorBrush x:Key="RingTrackBrush" Color="#FF27364B" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFF1F5FD" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFA3B3C8" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#FF708199" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF63D5EE" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF8AE4F5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF42B8D4" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#FF294D5A" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF172D3C" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF07131D" />
    <SolidColorBrush x:Key="HeroTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HeroInnerBrush" Color="#FF101A2B" />
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF6389FF" />
        <GradientStop Offset="1" Color="#FF43BCE3" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF153448" />
        <GradientStop Offset="0.6" Color="#FF17233A" />
        <GradientStop Offset="1" Color="#FF1A1D3B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF829FFF" />
        <GradientStop Offset="1" Color="#FF69D0EC" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroPressedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF4E70DC" />
        <GradientStop Offset="1" Color="#FF2EA3C4" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ControlBrush" Color="#FF152034" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF1C2A40" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF0E1726" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF31435C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF75DAB1" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFC875" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF8E99" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FF3A2029" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#FF152A3C" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FF9AEAF7" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF516680" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#FF8191A7" />

    <DropShadowEffect x:Key="CardShadowEffect" x:Shared="False" Color="#000000" Opacity="0.12" BlurRadius="18" ShadowDepth="3" Direction="270" />
    <DropShadowEffect x:Key="AccentGlowEffect" x:Shared="False" Color="#4BBEDB" Opacity="0.14" BlurRadius="12" ShadowDepth="0" />
    <DropShadowEffect x:Key="SuccessGlowEffect" x:Shared="False" Color="#75DAB1" Opacity="0.2" BlurRadius="7" ShadowDepth="0" />
    <DropShadowEffect x:Key="WarningGlowEffect" x:Shared="False" Color="#FFC875" Opacity="0.2" BlurRadius="7" ShadowDepth="0" />
    <DropShadowEffect x:Key="ErrorGlowEffect" x:Shared="False" Color="#FF8E99" Opacity="0.2" BlurRadius="7" ShadowDepth="0" />
</ResourceDictionary>
